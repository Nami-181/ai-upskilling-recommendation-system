# Copy to backend/.env and adjust. Never commit the real .env.

# PostgreSQL (docker compose up db gives you this one)
DATABASE_URL=postgresql+psycopg2://lumora:lumora@localhost:5432/lumora
# Quick start without PostgreSQL:
# DATABASE_URL=sqlite:///./lumora.db

SECRET_KEY=replace-with-output-of-python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# true = return verification / reset tokens in API responses when no SMTP is set (demo only)
DEMO_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=no-reply@lumora.app

AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
FIRST_ADMIN_EMAIL=admin@lumora.app
FIRST_ADMIN_PASSWORD=Admin@2026
