# Copy this file to `.env` and adjust values for your machine.
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put secrets (database passwords, API keys, JWT secrets) in this file —
# they belong in the FastAPI backend's own environment.

# Base URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# true  = use local mock data from src/data (no backend needed)
# false = call the real FastAPI endpoints
VITE_USE_MOCK_DATA=true

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000
